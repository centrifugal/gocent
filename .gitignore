# Output of `make cover` and profiles.
coverage.out
*.prof
*.pprof
*.test

# Left behind only if `make generate-check` is interrupted.
api_gen.go.orig

# Go workspace files, which are local to a checkout.
go.work
go.work.sum

# Editors and macOS.
.DS_Store
.idea/
.vscode/

# Note: testdata/fuzz/ is deliberately NOT ignored. Go writes failing fuzz
# inputs there, and those belong in the repository as regression seeds.
coverage.all.out
